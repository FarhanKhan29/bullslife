# Copy to .env.local and fill in. Both values are PUBLIC (publishable) client keys.
# NEVER put the service_role key here — it would be shipped to every browser.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Optional: set to "true" after running supabase/realtime_policies.sql to use private Realtime channels
VITE_SUPABASE_PRIVATE_CHANNELS=false
